    <connector id="connector2" type="male" name="RXD">
      <description>Asynchronous UART serial data input (RXD) with built-in controllable pull-up and pull-down resistors.</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector2pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector2pin" terminalId="connector2terminal"/></schematicView>
