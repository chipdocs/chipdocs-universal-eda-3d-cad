      </views>
    </connector>
    <connector id="connector3" type="male" name="V3">
      <description>Internal 3.3V LDO regulator node: connect to VCC when powered at 3.3V; connect a 100nF decoupling capacitor to GND when powered at 5V.</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector3pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector3pin" terminalId="connector3terminal"/></schematicView>
        <pcbView><p layer="copper1" svgId="connector3pad"/></pcbView>
      </views>
    </connector>
    <connector id="connector4" type="male" name="UD+">
      <description>USB Full-Speed Differential Data Plus (UD+ / D+, built-in 1.5kΩ pull-up) (直接连到USB总线的D+数据线 不要串联电阻 ，)</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector4pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector4pin" terminalId="connector4terminal"/></schematicView>
        <pcbView><p layer="copper1" svgId="connector4pad"/></pcbView>
