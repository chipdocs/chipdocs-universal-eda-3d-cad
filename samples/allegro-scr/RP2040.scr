# ChipDocs.org Clean-Room Cadence Allegro / OrCAD PCB Editor Footprint Script
# Component: RP2040 | Package: C2040_LQFN-56_7x7 | Standard: IPC-7351B / JEDEC MO-220
# Usage: In Allegro PCB Editor Command Window -> replay C2040_LQFN-56_7x7.scr
version 17.4
setwindow pcb
new
newdrawfillin "C2040_LQFN-56_7x7.dra" "Package Symbol"
prmed
setwindow form.prmedit
FORM prmedit units Millimeter
FORM prmedit accuracy 3
FORM prmedit width 28.26
FORM prmedit height 28.26
FORM prmedit x -14.13
FORM prmedit y -14.13
FORM prmedit done
setwindow pcb

# 1. Place IPC-7351B Electrical & Mechanical Pins
add pin
setwindow form.mini
FORM mini pad_name smd_88x20
FORM mini mechanical NO
FORM mini next_pin_number 1
FORM mini angle 0.00
setwindow pcb
pick -3.438 2.600
done
