# ChipDocs.org Clean-Room Cadence Allegro / OrCAD PCB Editor Footprint Script
# Component: STM32F103C8T6 | Package: C8734_LQFP-48_7x7 | Standard: IPC-7351B / JEDEC MS-026-BBC
# Usage: In Allegro PCB Editor Command Window -> replay C8734_LQFP-48_7x7.scr
version 17.4
setwindow pcb
new
newdrawfillin "C8734_LQFP-48_7x7.dra" "Package Symbol"
prmed
setwindow form.prmedit
FORM prmedit units Millimeter
FORM prmedit accuracy 3
FORM prmedit width 30.20
FORM prmedit height 30.20
FORM prmedit x -15.10
FORM prmedit y -15.10
FORM prmedit done
setwindow pcb

# 1. Place IPC-7351B Electrical & Mechanical Pins
add pin
setwindow form.mini
FORM mini pad_name smd_120x30
FORM mini mechanical NO
FORM mini next_pin_number 1
FORM mini angle 0.00
setwindow pcb
pick -4.250 2.750
done
add pin
setwindow form.mini
FORM mini pad_name smd_120x30
FORM mini mechanical NO
FORM mini next_pin_number 2
FORM mini angle 0.00
setwindow pcb
pick -4.250 2.250
done
add pin
setwindow form.mini
FORM mini pad_name smd_120x30
FORM mini mechanical NO
FORM mini next_pin_number 3
FORM mini angle 0.00
setwindow pcb
pick -4.250 1.750
done
add pin
setwindow form.mini
FORM mini pad_name smd_120x30
FORM mini mechanical NO
FORM mini next_pin_number 4
FORM mini angle 0.00
setwindow pcb
pick -4.250 1.250
done
