# 2. Clipped Top Silkscreen (PACKAGE GEOMETRY / SILKSCREEN_TOP)
add line
setwindow form.mini
FORM mini class PACKAGE GEOMETRY
FORM mini subclass SILKSCREEN_TOP
FORM mini line_width 0.15
setwindow pcb
pick -3.500 3.500
pick -3.120 3.500
next
pick 3.120 3.500
pick 3.500 3.500
next
pick 3.500 -3.500
pick 3.500 -3.120
next
pick 3.500 3.120
pick 3.500 3.500
next
pick -3.500 -3.500
pick -3.120 -3.500
next
pick 3.120 -3.500
pick 3.500 -3.500
next
pick -3.500 -3.500
pick -3.500 -3.120
next
pick -3.500 3.120
pick -3.500 3.500
next
done

# 3. IPC-7351B Courtyard & Max Package Height (PACKAGE GEOMETRY / PLACE_BOUND_TOP)
shape add rect
setwindow form.mini
FORM mini class PACKAGE GEOMETRY
FORM mini subclass PLACE_BOUND_TOP
setwindow pcb
pick -5.100 -5.100
pick 5.100 5.100
done
# Package Max Height = 1.600 mm | 3D STEP Model = C8734_LQFP-48_7x7_cleanroom.step
save_as
fillin "C8734_LQFP-48_7x7.dra"
create symbol
fillin "C8734_LQFP-48_7x7.psm"
