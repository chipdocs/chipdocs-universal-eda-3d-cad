# ChipDocs.org Clean-Room Cadence Allegro / OrCAD PCB Editor Footprint Script
# Component: ESP32-S3-WROOM-1-N16R2 | Package: C2913205_SMD_25_5x18mm | Standard: Clean-Room Metric Synthesis (CASTELLATED_MODULE)
# Usage: In Allegro PCB Editor Command Window -> replay C2913205_SMD_25_5x18mm.scr
version 17.4
setwindow pcb
new
newdrawfillin "C2913205_SMD_25_5x18mm.dra" "Package Symbol"
prmed
setwindow form.prmedit
FORM prmedit units Millimeter
FORM prmedit accuracy 3
FORM prmedit width 39.50
FORM prmedit height 46.54
FORM prmedit x -19.75
FORM prmedit y -23.54
FORM prmedit done
setwindow pcb

# 1. Place IPC-7351B Electrical & Mechanical Pins
add pin
setwindow form.mini
FORM mini pad_name smd_150x90
FORM mini mechanical NO
FORM mini next_pin_number 1
FORM mini angle 0.00
setwindow pcb
pick -8.750 5.250
done
