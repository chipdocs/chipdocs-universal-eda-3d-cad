# 2. Clipped Top Silkscreen (PACKAGE GEOMETRY / SILKSCREEN_TOP)
add line
setwindow form.mini
FORM mini class PACKAGE GEOMETRY
FORM mini subclass SILKSCREEN_TOP
FORM mini line_width 0.15
setwindow pcb
pick -9.000 12.750
pick 9.000 12.750
next
pick 9.000 -12.750
pick 9.000 -11.930
next
pick 9.000 5.920
pick 9.000 12.750
next
pick -9.000 -12.750
pick -7.655 -12.750
next
pick 7.655 -12.750
pick 9.000 -12.750
next
pick -9.000 -12.750
pick -9.000 -11.930
next
pick -9.000 5.920
pick -9.000 12.750
next
done

# 3. IPC-7351B Courtyard & Max Package Height (PACKAGE GEOMETRY / PLACE_BOUND_TOP)
shape add rect
setwindow form.mini
FORM mini class PACKAGE GEOMETRY
FORM mini subclass PLACE_BOUND_TOP
setwindow pcb
pick -9.750 -13.540
pick 9.750 13.000
done
# Package Max Height = 3.100 mm | 3D STEP Model = C2913205_SMD_25_5x18mm_cleanroom.step
save_as
fillin "C2913205_SMD_25_5x18mm.dra"
create symbol
fillin "C2913205_SMD_25_5x18mm.psm"
