# -*- coding: utf-8 -*-
'''ChipDocs.org Clean-Room FreeCAD OpenCASCADE B-Rep Macro for ESP32-S3-WROOM-1-N16R2 (C2913205_SMD_25_5x18mm).'''
import FreeCAD as App
import Part

doc = App.ActiveDocument or App.newDocument("ESP32_S3_WROOM_1_N16R2_C2913205_SMD_25_5x18mm")

def _build_prism(obj_id, display_label, bot_pts, extrude_vec, rgb):
    vecs = [App.Vector(p[0], p[1], p[2]) for p in bot_pts]
    vecs.append(vecs[0])
    wire = Part.makePolygon(vecs)
    face = Part.Face(wire)
    solid = face.extrude(App.Vector(extrude_vec[0], extrude_vec[1], extrude_vec[2]))
    obj = doc.addObject('Part::Feature', obj_id)
    obj.Label = display_label
    obj.Shape = solid
    if hasattr(obj, 'ViewObject') and obj.ViewObject:
        obj.ViewObject.ShapeColor = rgb
    return obj

