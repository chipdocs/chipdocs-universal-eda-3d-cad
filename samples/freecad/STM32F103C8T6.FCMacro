# -*- coding: utf-8 -*-
'''ChipDocs.org Clean-Room FreeCAD OpenCASCADE B-Rep Macro for STM32F103C8T6 (C8734_LQFP-48_7x7).'''
import FreeCAD as App
import Part

doc = App.ActiveDocument or App.newDocument("STM32F103C8T6_C8734_LQFP_48_7x7")

def _build_prism(obj_id, display_label, bot_pts, extrude_vec, rgb):
    vecs = [App.Vector(p[0], p[1], p[2]) for p in bot_pts]
    vecs.append(vecs[0])
    wire = Part.makePolygon(vecs)
    face = Part.Face(wire)
    solid = face.extrude(App.Vector(extrude_vec[0], extrude_vec[1], extrude_vec[2]))
    obj = doc.addObject('Part::Feature', obj_id)
    obj.Label = display_label
    obj.Shape = solid
    if hasattr(obj, 'ViewObject') and obj.ViewObject:
        obj.ViewObject.ShapeColor = rgb
    return obj

_build_prism("IC_BODY_1", "IC_BODY", [(-3.4000, -3.5000, 0.1000), (3.4000, -3.5000, 0.1000), (3.5000, -3.4000, 0.1000), (3.5000, 3.4000, 0.1000), (3.4000, 3.5000, 0.1000), (-2.8500, 3.5000, 0.1000), (-3.5000, 2.8500, 0.1000), (-3.5000, -3.4000, 0.1000)], (0.0, 0.0, 1.5), (0.120, 0.120, 0.130))
